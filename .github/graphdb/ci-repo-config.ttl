@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rep: <http://www.openrdf.org/config/repository#> .
@prefix sr: <http://www.openrdf.org/config/repository/sail#> .
@prefix sail: <http://www.openrdf.org/config/sail#> .
@prefix ms: <http://www.openrdf.org/config/sail/native#> .

[] a rep:Repository ;
    rep:repositoryID "coupled-modelling-ci-test" ;
    rdfs:label "Coupled Modelling CI Integration Test Repository" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:FreeSail" ;
            ms:evaluationStrategyFactory "com.ontotext.trree.evaluation.ExtendedEvaluationStrategyFactory"
        ]
    ] .
